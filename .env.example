# Shop đang chạy: thư mục shops/<SHOP_ID> (config.js, products.csv, custom-intents.js).
# adult-shop | nem-bui-xa | ...
SHOP_ID=adult-shop

# Lấy tại: aistudio.google.com → Get API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Lấy tại: developers.facebook.com → App → Messenger → Access Tokens
FB_PAGE_TOKEN=your_facebook_page_token_here

# Tự đặt một chuỗi ngẫu nhiên (đừng dùng giá trị mặc định public)
FB_VERIFY_TOKEN=please_change_me_to_a_random_string

# Lấy tại: developers.facebook.com → App → Settings → Basic → "App Secret"
# Dùng để xác thực chữ ký webhook (khuyến nghị bật)
FB_APP_SECRET=your_facebook_app_secret_here

# (Tuỳ chọn) Đổi model Gemini nếu muốn. Mặc định: gemini-2.5-flash
GEMINI_MODEL=gemini 1.5 Pro

# Bật/tắt Gemini fallback. Set false để bot chỉ dùng rule-based, không gọi Gemini.
USE_GEMINI=false

# Port (Railway/Render tự set, không cần đổi)
PORT=3000

# Base URL public của app để Messenger lấy ảnh sản phẩm/menu
# Ví dụ Railway: https://ten-app.up.railway.app
# Có thể bỏ trống nếu dùng RAILWAY_PUBLIC_DOMAIN hoặc RENDER_EXTERNAL_URL
PUBLIC_BASE_URL=

# Token bí mật để tải danh sách khách qua trình duyệt:
# https://ten-app.up.railway.app/api/admin/leads?token=your_secret_token
ADMIN_EXPORT_TOKEN=your_long_random_admin_token_here

# Secret dùng để mã hóa JWT cho Dashboard Login (Bắt buộc phải có)
# Nên dùng một chuỗi ngẫu nhiên dài và phức tạp
JWT_SECRET=zenbot_super_secret_key_for_saas_dashboard

# Rate limit mặc định đã đủ cho production nhỏ. Chỉ đổi khi cần.
# Set DISABLE_RATE_LIMIT=true chỉ khi debug nội bộ, không dùng production.
DISABLE_RATE_LIMIT=false
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX=120
UPLOAD_RATE_LIMIT_WINDOW_MS=600000
UPLOAD_RATE_LIMIT_MAX=40
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=300

# Ảnh upload sẽ được xoay đúng EXIF, resize và convert sang WebP.
IMAGE_MAX_WIDTH=1600
IMAGE_MAX_HEIGHT=1600
IMAGE_WEBP_QUALITY=82

# (Tuỳ chọn) Thư mục lưu state/lead. Khi dùng Railway Volume, set DATA_DIR bằng mount path.
# Ví dụ nếu Volume mount ở /data thì set: DATA_DIR=/data
# Local có thể bỏ trống để dùng ./data
DATA_DIR=/data
SHOPS_DIR=/data/shops
# (Tuỳ chọn) Web App URL (Google Apps Script doPost) để đẩy lead khi đơn CONFIRMED.
# Không set = không gọi; luồng customers.csv vẫn giữ nguyên.
# JSON body có dedupeKey (SHA-256 hex): trong Script kiểm tra trùng trước khi append hàng.
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your_apps_script_deployment_id/exec

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# [Giai Đoạn 1] Cấu hình Redis (dùng cho BullMQ và lưu State)
REDIS_URL="rediss://default:mat_khau_redis@xxxx.upstash.io:6379"

# [Giai Đoạn 1] Cấu hình MongoDB (dùng để lưu cấu hình của các Shop)
MONGODB_URI="mongodb+srv://username:password@cluster0.xxxx.mongodb.net/zenbot?retryWrites=true&w=majority"
